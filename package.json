{
  "name": "@vrixton/pixel-pet",
  "version": "0.6.1",
  "description": "A pixel art pet for React that walks, sleeps, reacts to clicks, and speaks on demand.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "playground": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": "^19"
  },
    "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "react",
    "virtual-pet",
    "pixel-art",
    "widget"
  ],
  "author": "Victor Villavicencio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vrixton/pixel-pet.git"
  },
  "bugs": {
    "url": "https://github.com/Vrixton/pixel-pet/issues"
  },
  "homepage": "https://github.com/Vrixton/pixel-pet#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.5.1"
}
